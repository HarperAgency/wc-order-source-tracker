{
    "name": "claritymomentum/cm-order-source-tracker",
    "description": "Capture UTM parameters, referrer, and landing page from the visitor session and attach them to WooCommerce orders.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "php-stubs/woocommerce-stubs": "^10.9",
        "php-stubs/wordpress-stubs": "^6.9",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "ClarityMomentum\\OrderSourceTracker\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClarityMomentum\\OrderSourceTracker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration tests/phpunit.xml",
        "phpcs": "phpcs --standard=phpcs.xml .",
        "phpstan": "phpstan analyse --configuration phpstan.neon"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
